rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function validTimestampsOnCreate(data) {
      return data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function validTimestampsOnUpdate(data) {
      return data.createdAt == existing().createdAt &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 1. User Profile (/users/{userId})
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('age' in data) || (data.age is int && data.age >= 10 && data.age <= 120)) &&
             (!('fitnessGoal' in data) || (data.fitnessGoal is string && data.fitnessGoal.size() <= 120)) &&
             (!('preferredWorkout' in data) || (data.preferredWorkout is string && data.preferredWorkout.size() <= 60)) &&
             (!('dailyCalorieGoal' in data) || (data.dailyCalorieGoal is int && data.dailyCalorieGoal >= 800 && data.dailyCalorieGoal <= 8000)) &&
             (!('dailyWaterGoalMl' in data) || (data.dailyWaterGoalMl is int && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 10000)) &&
             (!('dailyProteinGoalG' in data) || (data.dailyProteinGoalG is int && data.dailyProteinGoalG >= 10 && data.dailyProteinGoalG <= 500)) &&
             (!('vegetarianDefault' in data) || data.vegetarianDefault is bool) &&
             (!('challengePoints' in data) || (data.challengePoints is int && data.challengePoints >= 0)) &&
             (!('disciplinePoints' in data) || (data.disciplinePoints is int && data.disciplinePoints >= 0)) &&
             (!('challengeLevel' in data) || (data.challengeLevel is int && data.challengeLevel >= 1 && data.challengeLevel <= 10)) &&
             (!('punishmentLevel' in data) || (data.punishmentLevel is int && data.punishmentLevel >= 1 && data.punishmentLevel <= 10)) &&
             (!('currentStreak' in data) || (data.currentStreak is int && data.currentStreak >= 0)) &&
             (!('longestStreak' in data) || (data.longestStreak is int && data.longestStreak >= 0)) &&
             (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 20)) &&
             (!('recoveryDates' in data) || (data.recoveryDates is list && data.recoveryDates.size() <= 366 && (data.recoveryDates.size() == 0 || data.recoveryDates[0] is string))) &&
             (!('activeDates' in data) || (data.activeDates is list && data.activeDates.size() <= 366 && (data.activeDates.size() == 0 || data.activeDates[0] is string))) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('workoutReminderEnabled' in data) || data.workoutReminderEnabled is bool) &&
             (!('workoutReminderHour' in data) || (data.workoutReminderHour is int && data.workoutReminderHour >= 0 && data.workoutReminderHour <= 23)) &&
             (!('workoutReminderMinute' in data) || (data.workoutReminderMinute is int && data.workoutReminderMinute >= 0 && data.workoutReminderMinute <= 59)) &&
             (!('waterReminderEnabled' in data) || data.waterReminderEnabled is bool) &&
             (!('missionReminderEnabled' in data) || data.missionReminderEnabled is bool) &&
             (!('streakReminderEnabled' in data) || data.streakReminderEnabled is bool) &&
             (!('themeAccent' in data) || (data.themeAccent is string && data.themeAccent in ['NEON_LIME', 'ELECTRIC_VOLT', 'CYBER_EMERALD'])) &&
             (!('profilePrivate' in data) || data.profilePrivate is bool) &&
             (!('hasSignature' in data) || data.hasSignature is bool) &&
             (!('signatureUpdatedAtMillis' in data) || (data.signatureUpdatedAtMillis is int && data.signatureUpdatedAtMillis >= 0));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'age', 'fitnessGoal', 'preferredWorkout',
                         'dailyCalorieGoal', 'dailyWaterGoalMl', 'dailyProteinGoalG', 'vegetarianDefault',
                         'challengePoints', 'disciplinePoints', 'challengeLevel', 'punishmentLevel',
                         'currentStreak', 'longestStreak', 'lastActiveDate', 'recoveryDates', 'activeDates',
                         'notificationsEnabled', 'workoutReminderEnabled', 'workoutReminderHour', 'workoutReminderMinute',
                         'waterReminderEnabled', 'missionReminderEnabled', 'streakReminderEnabled',
                         'themeAccent', 'profilePrivate', 'hasSignature', 'signatureUpdatedAtMillis',
                         'createdAt', 'updatedAt'
                       ]) &&
                       validTimestampsOnCreate(incoming()) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       validTimestampsOnUpdate(incoming()) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'age', 'fitnessGoal', 'preferredWorkout',
                         'dailyCalorieGoal', 'dailyWaterGoalMl', 'dailyProteinGoalG', 'vegetarianDefault',
                         'challengePoints', 'disciplinePoints', 'challengeLevel', 'punishmentLevel',
                         'currentStreak', 'longestStreak', 'lastActiveDate', 'recoveryDates', 'activeDates',
                         'notificationsEnabled', 'workoutReminderEnabled', 'workoutReminderHour', 'workoutReminderMinute',
                         'waterReminderEnabled', 'missionReminderEnabled', 'streakReminderEnabled',
                         'themeAccent', 'profilePrivate', 'hasSignature', 'signatureUpdatedAtMillis',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Private Assets (/users/{userId}/private/{assetId})
      function isValidPrivateAsset(data) {
        return data.userId is string && data.userId == userId &&
               data.assetType is string && data.assetType in ['SIGNATURE', 'PROFILE_PHOTO'] &&
               data.imageBase64 is string && data.imageBase64.size() >= 1 && data.imageBase64.size() <= 750000 &&
               data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 40;
      }

      match /private/{assetId} {
        allow get: if isOwner(userId) && isValidId(assetId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(assetId) &&
                         incoming().keys().hasAll(['userId', 'assetType', 'imageBase64', 'mimeType', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'assetType', 'imageBase64', 'mimeType', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidPrivateAsset(incoming());
        allow update: if isOwner(userId) && isValidId(assetId) &&
                         incoming().userId == existing().userId &&
                         validTimestampsOnUpdate(incoming()) &&
                         isValidPrivateAsset(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['assetType', 'imageBase64', 'mimeType', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(assetId);
      }

      // 3. Workouts (/users/{userId}/workouts/{workoutId})
      function isValidWorkout(data) {
        return data.userId is string && data.userId == userId &&
               data.workoutType is string && data.workoutType in ['OUTDOOR_WALK', 'OUTDOOR_RUN', 'OUTDOOR_ROWING', 'FUNCTIONAL_STRENGTH', 'SPRINT_TRAINING', 'CUSTOM'] &&
               (!('customTitle' in data) || (data.customTitle is string && data.customTitle.size() <= 80)) &&
               data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
               (!('distanceMeters' in data) || (data.distanceMeters is number && data.distanceMeters >= 0)) &&
               (!('averagePaceSecPerKm' in data) || (data.averagePaceSecPerKm is number && data.averagePaceSecPerKm >= 0)) &&
               data.caloriesBurned is int && data.caloriesBurned >= 0 && data.caloriesBurned <= 10000 &&
               (!('gpsTracked' in data) || data.gpsTracked is bool) &&
               (!('gpsPointCount' in data) || (data.gpsPointCount is int && data.gpsPointCount >= 0)) &&
               data.dateKey is string && data.dateKey.size() == 10 &&
               (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
      }

      match /workouts/{workoutId} {
        allow get: if isOwner(userId) && isValidId(workoutId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workoutId) &&
                         incoming().keys().hasAll(['userId', 'workoutType', 'durationSeconds', 'caloriesBurned', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'workoutType', 'customTitle', 'durationSeconds', 'distanceMeters', 'averagePaceSecPerKm', 'caloriesBurned', 'gpsTracked', 'gpsPointCount', 'dateKey', 'notes', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidWorkout(incoming());
        allow update: if isOwner(userId) && isValidId(workoutId) &&
                         incoming().userId == existing().userId &&
                         validTimestampsOnUpdate(incoming()) &&
                         isValidWorkout(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['customTitle', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(workoutId);
      }

      // 4. Sprints (/users/{userId}/sprints/{sprintId})
      function isValidSprint(data) {
        return data.userId is string && data.userId == userId &&
               data.distanceMeters is int && data.distanceMeters in [30, 60, 100] &&
               data.timeMillis is int && data.timeMillis > 0 && data.timeMillis <= 600000 &&
               (!('manualEntry' in data) || data.manualEntry is bool) &&
               (!('personalBest' in data) || data.personalBest is bool) &&
               data.dateKey is string && data.dateKey.size() == 10;
      }

      match /sprints/{sprintId} {
        allow get: if isOwner(userId) && isValidId(sprintId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sprintId) &&
                         incoming().keys().hasAll(['userId', 'distanceMeters', 'timeMillis', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'distanceMeters', 'timeMillis', 'manualEntry', 'personalBest', 'dateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidSprint(incoming());
        allow update: if isOwner(userId) && isValidId(sprintId) &&
                         incoming().userId == existing().userId &&
                         validTimestampsOnUpdate(incoming()) &&
                         isValidSprint(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['personalBest', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(sprintId);
      }

      // 5. Rest Logs (/users/{userId}/rest_logs/{restId})
      function isValidRestLog(data) {
        return data.userId is string && data.userId == userId &&
               data.plannedSeconds is int && data.plannedSeconds > 0 && data.plannedSeconds <= 3600 &&
               data.actualSeconds is int && data.actualSeconds >= 0 && data.actualSeconds <= 7200 &&
               data.status is string && data.status in ['COMPLETED', 'SKIPPED'] &&
               data.dateKey is string && data.dateKey.size() == 10;
      }

      match /rest_logs/{restId} {
        allow get: if isOwner(userId) && isValidId(restId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(restId) &&
                         incoming().keys().hasAll(['userId', 'plannedSeconds', 'actualSeconds', 'status', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'plannedSeconds', 'actualSeconds', 'status', 'dateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidRestLog(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(restId);
      }

      // 6. Meals (/users/{userId}/meals/{mealId})
      function isValidMeal(data) {
        return data.userId is string && data.userId == userId &&
               data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 100 &&
               data.mealType is string && data.mealType in ['BREAKFAST', 'LUNCH', 'DINNER', 'SNACK'] &&
               data.calories is int && data.calories >= 0 && data.calories <= 10000 &&
               (!('proteinG' in data) || (data.proteinG is int && data.proteinG >= 0 && data.proteinG <= 500)) &&
               (!('carbsG' in data) || (data.carbsG is int && data.carbsG >= 0 && data.carbsG <= 1000)) &&
               (!('fatsG' in data) || (data.fatsG is int && data.fatsG >= 0 && data.fatsG <= 500)) &&
               (!('vegetarian' in data) || data.vegetarian is bool) &&
               data.dateKey is string && data.dateKey.size() == 10;
      }

      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(mealId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mealId) &&
                         incoming().keys().hasAll(['userId', 'foodName', 'mealType', 'calories', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'foodName', 'mealType', 'calories', 'proteinG', 'carbsG', 'fatsG', 'vegetarian', 'dateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidMeal(incoming());
        allow update: if isOwner(userId) && isValidId(mealId) &&
                         incoming().userId == existing().userId &&
                         validTimestampsOnUpdate(incoming()) &&
                         isValidMeal(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['foodName', 'mealType', 'calories', 'proteinG', 'carbsG', 'fatsG', 'vegetarian', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // 7. Water Logs (/users/{userId}/water_logs/{waterId})
      function isValidWaterLog(data) {
        return data.userId is string && data.userId == userId &&
               data.amountMl is int && data.amountMl >= 1 && data.amountMl <= 10000 &&
               data.dateKey is string && data.dateKey.size() == 10;
      }

      match /water_logs/{waterId} {
        allow get: if isOwner(userId) && isValidId(waterId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(waterId) &&
                         incoming().keys().hasAll(['userId', 'amountMl', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'amountMl', 'dateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidWaterLog(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(waterId);
      }

      // 8. Missions (/users/{userId}/missions/{missionId})
      function isValidMission(data) {
        return data.userId is string && data.userId == userId &&
               data.missionKey is string && data.missionKey.size() >= 1 && data.missionKey.size() <= 80 &&
               data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
               (!('description' in data) || (data.description is string && data.description.size() <= 250)) &&
               data.timeframe is string && data.timeframe in ['DAILY', 'WEEKLY', 'MONTHLY'] &&
               data.category is string && data.category in ['RUNNING', 'SPRINT', 'STRENGTH', 'HYDRATION', 'CONSISTENCY', 'SPECIAL', 'CHALLENGE'] &&
               data.difficulty is string && data.difficulty in ['EASY', 'MEDIUM', 'HARD', 'ELITE'] &&
               data.targetValue is int && data.targetValue > 0 &&
               data.currentValue is int && data.currentValue >= 0 &&
               data.rewardPoints is int && data.rewardPoints > 0 &&
               (!('deadlineKey' in data) || (data.deadlineKey is string && data.deadlineKey.size() <= 20)) &&
               data.status is string && data.status in ['ACTIVE', 'COMPLETED', 'SKIPPED'] &&
               (!('completedDateKey' in data) || (data.completedDateKey is string && data.completedDateKey.size() <= 20));
      }

      match /missions/{missionId} {
        allow get: if isOwner(userId) && isValidId(missionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(missionId) &&
                         incoming().keys().hasAll(['userId', 'missionKey', 'title', 'timeframe', 'category', 'difficulty', 'targetValue', 'currentValue', 'rewardPoints', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'missionKey', 'title', 'description', 'timeframe', 'category', 'difficulty', 'targetValue', 'currentValue', 'rewardPoints', 'deadlineKey', 'status', 'completedDateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidMission(incoming());
        allow update: if isOwner(userId) && isValidId(missionId) &&
                         incoming().userId == existing().userId &&
                         existing().status == 'ACTIVE' &&
                         validTimestampsOnUpdate(incoming()) &&
                         isValidMission(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['currentValue', 'status', 'completedDateKey', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(missionId);
      }

      // 9. Medals (/users/{userId}/medals/{medalId})
      function isValidMedal(data) {
        return data.userId is string && data.userId == userId &&
               data.medalKey is string && data.medalKey.size() >= 1 && data.medalKey.size() <= 60 &&
               data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
               data.tier is string && data.tier in ['BRONZE', 'SILVER', 'GOLD', 'PLATINUM', 'SPECIAL'] &&
               data.description is string && data.description.size() >= 1 && data.description.size() <= 250 &&
               data.unlockedDateKey is string && data.unlockedDateKey.size() == 10;
      }

      match /medals/{medalId} {
        allow get: if isOwner(userId) && isValidId(medalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(medalId) &&
                         incoming().keys().hasAll(['userId', 'medalKey', 'title', 'tier', 'description', 'unlockedDateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'medalKey', 'title', 'tier', 'description', 'unlockedDateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidMedal(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(medalId);
      }

      // 10. Certificates (/users/{userId}/certificates/{certId})
      function isValidCertificate(data) {
        return data.userId is string && data.userId == userId &&
               data.certificateCode is string && data.certificateCode.size() >= 1 && data.certificateCode.size() <= 40 &&
               data.certificateName is string && data.certificateName.size() >= 1 && data.certificateName.size() <= 120 &&
               data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80 &&
               data.achievementDescription is string && data.achievementDescription.size() >= 1 && data.achievementDescription.size() <= 250 &&
               data.medalEarned is string && data.medalEarned.size() >= 1 && data.medalEarned.size() <= 100 &&
               data.completionDateKey is string && data.completionDateKey.size() == 10;
      }

      match /certificates/{certId} {
        allow get: if isOwner(userId) && isValidId(certId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(certId) &&
                         incoming().keys().hasAll(['userId', 'certificateCode', 'certificateName', 'recipientName', 'achievementDescription', 'medalEarned', 'completionDateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'certificateCode', 'certificateName', 'recipientName', 'achievementDescription', 'medalEarned', 'completionDateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidCertificate(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(certId);
      }

      // 11. Discipline Logs (/users/{userId}/discipline_logs/{logId})
      function isValidDisciplineLog(data) {
        return data.userId is string && data.userId == userId &&
               data.exerciseType is string && data.exerciseType in ['UTHAK_BAITHAK', 'SIT_UPS', 'WALL_PUSH_UPS', 'KNEE_RAISES', 'LIGHT_WALKING', 'MOBILITY', 'OPTIONAL_CHALLENGE'] &&
               data.level is int && data.level >= 1 && data.level <= 10 &&
               (!('repsCompleted' in data) || (data.repsCompleted is int && data.repsCompleted >= 0 && data.repsCompleted <= 500)) &&
               (!('durationSeconds' in data) || (data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 7200)) &&
               data.status is string && data.status in ['COMPLETED', 'SKIPPED', 'RECOVERY_DAY'] &&
               (!('pointsAwarded' in data) || (data.pointsAwarded is int && data.pointsAwarded >= 0 && data.pointsAwarded <= 1000)) &&
               data.dateKey is string && data.dateKey.size() == 10;
      }

      match /discipline_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) &&
                         incoming().keys().hasAll(['userId', 'exerciseType', 'level', 'status', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'exerciseType', 'level', 'repsCompleted', 'durationSeconds', 'status', 'pointsAwarded', 'dateKey', 'createdAt', 'updatedAt']) &&
                         validTimestampsOnCreate(incoming()) &&
                         isValidDisciplineLog(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
